+    static bool SceneKnownStage3Boss1SignatureMatches()
+    {
+        __try {
+            const uintptr_t eclBaseSlot = GetMemAddr(0x477704, 0x54, 0x0c);
+            if (!eclBaseSlot) return false;
+            const uintptr_t eclData = *(uintptr_t*)eclBaseSlot;
+            if (!eclData) return false;
+            static const uint32_t jumpAtCa48[6] = { 0, 0x0018000c, 0x02ff0000, 0, 0x190c, 5885 };
+            static const uint32_t jumpAtE384[6] = { 0, 0x0018000c, 0x02ff0000, 0, 0x24, 5885 };
+            return SceneBytesMatch(eclData + 0xca48, (const uint8_t*)jumpAtCa48, sizeof(jumpAtCa48))
+                && SceneBytesMatch(eclData + 0xe384, (const uint8_t*)jumpAtE384, sizeof(jumpAtE384));
+        } __except (EXCEPTION_EXECUTE_HANDLER) {
+            return false;
+        }
+    }
+
+    static SectionPatchVerification SceneVerifyKnownSectionPatch()
+    {
+        if (sceneRequest.stage != 3 || sceneRequest.section_kind != (int)thprac_scene_bridge::SectionKind::Boss
+            || sceneRequest.section_index != 0
+            || sceneRequest.section_dialogue_policy != (int)SectionDialoguePolicy::SkipSectionDialogue)
+            return SectionPatchVerification::Unverified;
+
+        return SceneKnownStage3Boss1SignatureMatches()
+            ? SectionPatchVerification::Matched
+            : SectionPatchVerification::Mismatch;
+    }
