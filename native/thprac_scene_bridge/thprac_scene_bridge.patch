+    static void ScenePublish(Status status, Error error = Error::None)
+    {
+        if (!sceneBridge) return;
+        InterlockedIncrement(&sceneBridge->response_lock);
+        sceneBridge->status = (LONG)status;
+        sceneBridge->error = (LONG)error;
+        sceneBridge->response_sequence = sceneRequestSequence;
+        sceneBridge->last_update_tick_ms = GetTickCount64();
+        InterlockedIncrement(&sceneBridge->response_lock);
+    }
