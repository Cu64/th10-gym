+    static void SceneBeginResponseWrite() { if (sceneBridge) InterlockedIncrement(&sceneBridge->response_lock); }
+    static void SceneEndResponseWrite() { if (sceneBridge) InterlockedIncrement(&sceneBridge->response_lock); }
+
+    static bool SceneReadGameOverRestartGuard(SceneRestartGuard& guard)
+    {
+        __try {
+            const uintptr_t owner = *(volatile uintptr_t*)0x477830;
+            if (!owner || owner < 0x400000 || owner > 0x7ffe0000) return false;
+            guard.ownerState = *(volatile LONG*)(owner + 0x04);
+            guard.ownerPathMarker = *(volatile LONG*)(owner + 0x1e4);
+            guard.lives = *(volatile LONG*)0x474c70;
+            guard.stage = *(volatile LONG*)0x474c7c;
+            guard.modeFlags = *(volatile LONG*)0x474ca0;
+            guard.managerFlags = *(volatile LONG*)(0x491c28 + 0x3cc);
+            guard.input = *(volatile uint16_t*)0x474e5c;
+            guard.frontendInput = *(volatile uint32_t*)0x474e30;
+            return true;
+        } __except (EXCEPTION_EXECUTE_HANDLER) {
+            return false;
+        }
+    }
+
+    static bool SceneQueueRetailReturnToTitle()
+    {
+        static const uint8_t preimage[16] = {
+            0x8b, 0x88, 0xcc, 0x03, 0x00, 0x00, 0xf6, 0xc5,
+            0x10, 0x75, 0x0d, 0x8b, 0x4c, 0x24, 0x04, 0x89
+        };
+        if (!SceneBytesMatch(0x40ac90, preimage, sizeof(preimage))) return false;
+        __try {
+            // Exact retail call shape: PUSH 4; MOV EAX,491C28; CALL 40AC90.
+            __asm {
+                push 4
+                mov eax, 0491c28h
+                mov ecx, 040ac90h
+                call ecx
+            }
+            return true;
+        } __except (EXCEPTION_EXECUTE_HANDLER) {
+            return false;
+        }
+    }
+
+    static bool SceneQueueGameplayRestart(thprac_scene_bridge::RestartRoute route)
+    {
+        using thprac_scene_bridge::RestartRoute;
+        const auto manager = GetMemContent(0x477810);
+        const auto replay = GetMemContent(0x477838);
+        if (!manager || !replay) return false;
+        const auto managerFlags = GetMemContent(manager + 0x58);
+        const bool changingProfile = route == RestartRoute::ProfileChange;
+        auto boundary = route;
+        if (changingProfile) {
+            boundary = RestartRoute::RetailRetry;
+            if (managerFlags & 0x10)
+                boundary = (int32_t)GetMemContent(0x474c70) == -1
+                    ? RestartRoute::GameOverRetry : RestartRoute::PracticeCompleteRetry;
+        }
+        const thprac_scene_bridge::RetailRetryState observed{
+            .stage = (int32_t)GetMemContent(0x474c7c),
+            .startStage = (int32_t)GetMemContent(0x474c80),
+            .modeFlags = GetMemContent(0x474ca0),
+            .currentState = (int32_t)GetMemContent(0x491fb8),
+            .previousState = (int32_t)GetMemContent(0x491fb4),
+            .managerFlags = managerFlags,
+            .replayMode = (int32_t)GetMemContent(replay + 0x10),
+            .input = *(volatile uint16_t*)0x474e5c,
+            .frontendInput = *(volatile uint32_t*)0x474e30,
+        };
+        if (!thprac_scene_bridge::Th10RetailRetryAllowed(
+                observed, sceneRequest.stage, sceneNormalRunActive, boundary, changingProfile))
+            return false;
+        if (boundary != RestartRoute::RetailRetry &&
+            (!SceneReadGameOverRestartGuard(sceneRestartGuard) ||
+             !thprac_scene_bridge::Th10RetailRetryTerminalMatches(
+                 boundary, sceneNormalRunActive, sceneRestartGuard.ownerState,
+                sceneRestartGuard.ownerPathMarker, sceneRestartGuard.lives)))
+            return false;
+        if (changingProfile) return SceneQueueRetailReturnToTitle();
+
+        static const uint8_t retryStore[] = {
+            0xc7, 0x05, 0xb8, 0x1f, 0x49, 0x00, 0x0a, 0x00, 0x00, 0x00,
+        };
+        if (!SceneBytesMatch(0x42316c, retryStore, sizeof(retryStore))) return false;
+        // Request a fresh start even at Game Over, where the menu can keep
+        // the current stage. The supervisor owns teardown and initialization.
+        *(volatile LONG*)0x491fb8 = 10;
+        return true;
+    }
+
+    static void SceneRestartPublish(LONG sequence, thprac_scene_bridge::RestartStatus status,
+        thprac_scene_bridge::RestartPhase phase, LONG error = 0)
+    {
+        if (!sceneBridge) return;
+        SceneBeginResponseWrite();
+        sceneBridge->restart_status = (LONG)status;
+        sceneBridge->restart_error = error;
+        sceneBridge->restart_phase = (LONG)phase;
+        sceneBridge->restart_input_polls = sceneRestartInputPolls;
+        sceneBridge->restart_last_input_active = sceneRestartLastInputActive;
+        sceneBridge->restart_input_hook_entries = sceneRestartInputHookEntries;
+        sceneBridge->restart_inactive_input_polls = sceneRestartInactiveInputPolls;
+        sceneBridge->restart_synthetic_input_polls = 0;
+        sceneBridge->restart_guard_owner_state = sceneRestartGuard.ownerState;
+        sceneBridge->restart_guard_owner_path_marker = sceneRestartGuard.ownerPathMarker;
+        sceneBridge->restart_guard_lives = sceneRestartGuard.lives;
+        sceneBridge->restart_guard_stage = sceneRestartGuard.stage;
+        sceneBridge->restart_guard_mode_flags = sceneRestartGuard.modeFlags;
+        sceneBridge->restart_guard_manager_flags = sceneRestartGuard.managerFlags;
+        sceneBridge->restart_guard_input = sceneRestartGuard.input;
+        sceneBridge->restart_guard_frontend_input = sceneRestartGuard.frontendInput;
+        sceneBridge->restart_response_sequence = sequence;
+        SceneEndResponseWrite();
+    }
+
+    // Poll on the game thread after input merging and before the supervisor update.
+    static void ScenePollRestart(bool inputActive)
+    {
+        if (!sceneBridge) return;
+        const LONG requestSequence = InterlockedCompareExchange(
+            &sceneBridge->restart_request_sequence, 0, 0);
+        if (requestSequence <= 0) return;
+        const auto recordInputState = [&]() {
+            sceneRestartLastInputActive = inputActive ? 1 : 0;
+            if (sceneRestartInputHookEntries < 0x7fffffffL)
+                ++sceneRestartInputHookEntries;
+            if (!inputActive && sceneRestartInactiveInputPolls < 0x7fffffffL)
+                ++sceneRestartInactiveInputPolls;
+        };
+        if (requestSequence != sceneRestartSequence) {
+            sceneRetryPending = false;
+            sceneRetrySequence = 0;
+            memset(sceneRetryRequestId, 0, sizeof(sceneRetryRequestId));
+            sceneRetryDeadlineMs = 0;
+            LONG status = InterlockedCompareExchange(&sceneBridge->restart_status, 0, 0);
+            LONG route = InterlockedCompareExchange(&sceneBridge->restart_route, 0, 0);
+            uint8_t sceneId[16] = {};
+            memcpy(sceneId, sceneBridge->restart_scene_request_id, sizeof(sceneId));
+            MemoryBarrier();
+            const LONG sequenceAfter = InterlockedCompareExchange(
+                &sceneBridge->restart_request_sequence, 0, 0);
+            const LONG routeAfter = InterlockedCompareExchange(&sceneBridge->restart_route, 0, 0);
+            const bool requestStable = requestSequence == sequenceAfter && route == routeAfter;
+            const bool cheatsDisabled = sceneRequest.invincible == 0
+                && sceneRequest.infinite_lives == 0 && sceneRequest.infinite_power == 0
+                && sceneRequest.time_lock == 0 && sceneRequest.auto_bomb == 0
+                && sceneRequest.no_faith_loss == 0;
+            const bool requestIdMatches = memcmp(
+                sceneId, sceneRequest.request_id, sizeof(sceneId)) == 0;
+            const bool valid = requestStable
+                && status == (LONG)thprac_scene_bridge::RestartStatus::Queued
+                && sceneRequestSequence > 0
+                && sceneBridge->applied_section_kind == sceneRequest.section_kind
+                && sceneBridge->applied_stage == sceneRequest.stage
+                && thprac_scene_bridge::Th10RestartSessionAllowed(
+                    (thprac_scene_bridge::RestartRoute)route, {
+                        .startedConfigured = sceneBridge->status == (LONG)Status::StartedConfigured,
+                        .sectionKind = sceneRequest.section_kind,
+                        .stage = sceneRequest.stage,
+                        .normalRunActive = sceneNormalRunActive,
+                        .practiceMode = (GetMemContent(0x474ca0)
+                            & thprac_scene_bridge::kTh10PracticeModeFlag) != 0,
+                        .cheatsDisabled = cheatsDisabled,
+                        .requestIdMatches = requestIdMatches,
+                    });
+            sceneRestartSequence = requestSequence;
+            sceneRestartInputPolls = 0;
+            sceneRestartLastInputActive = 0;
+            sceneRestartInputHookEntries = 0;
+            sceneRestartInactiveInputPolls = 0;
+            recordInputState();
+            sceneRestartRoute = route;
+            sceneRestartPhase = (LONG)thprac_scene_bridge::RestartPhase::None;
+            sceneRestartAwaitingTitle = false;
+            sceneRestartGuard = SceneRestartGuard{};
+            if (!valid) {
+                SceneRestartPublish(requestSequence,
+                    thprac_scene_bridge::RestartStatus::Rejected,
+                    thprac_scene_bridge::RestartPhase::None, 1);
+                return;
+            }
+            const auto restartRoute = (thprac_scene_bridge::RestartRoute)sceneRestartRoute;
+            const bool retailRetry = thprac_scene_bridge::Th10IsRetailRetry(restartRoute);
+            const bool changingProfile = restartRoute == thprac_scene_bridge::RestartRoute::ProfileChange;
+            if ((retailRetry || changingProfile) && (GetTickCount64() >= sceneBridge->restart_deadline_tick_ms
+                    || !SceneQueueGameplayRestart(restartRoute))) {
+                SceneRestartPublish(requestSequence,
+                    thprac_scene_bridge::RestartStatus::Rejected,
+                    thprac_scene_bridge::RestartPhase::None, 5);
+                return;
+            }
+            if (retailRetry) {
+                sceneRetryPending = true;
+                sceneRetrySequence = requestSequence;
+                memcpy(sceneRetryRequestId, sceneRequest.request_id,
+                    sizeof(sceneRetryRequestId));
+                sceneRetryDeadlineMs = sceneBridge->restart_deadline_tick_ms;
+                sceneRestartPhase = (LONG)thprac_scene_bridge::RestartPhase::AwaitStartup;
+                SceneRestartPublish(requestSequence,
+                    thprac_scene_bridge::RestartStatus::ActionQueued,
+                    thprac_scene_bridge::RestartPhase::AwaitStartup);
+                return;
+            }
+            if (changingProfile) {
+                sceneRestartAwaitingTitle = true;
+                sceneRestartPhase = (LONG)thprac_scene_bridge::RestartPhase::AwaitTitle;
+                SceneRestartPublish(requestSequence,
+                    thprac_scene_bridge::RestartStatus::ActionQueued,
+                    thprac_scene_bridge::RestartPhase::AwaitTitle);
+                return;
+            }
+            if (thprac_scene_bridge::Th10ReturnsToTitle(restartRoute)) {
+                SceneRestartGuard guard;
+                const bool readable = SceneReadGameOverRestartGuard(guard);
+                sceneRestartGuard = guard;
+                const bool normalRoute = sceneRestartRoute ==
+                    (LONG)thprac_scene_bridge::RestartRoute::GameOverReturnTitle;
+                const bool practiceFailureRoute = sceneRestartRoute ==
+                    (LONG)thprac_scene_bridge::RestartRoute::PracticeGameOverReturnTitle;
+                const bool terminal = normalRoute
+                    ? thprac_scene_bridge::Th10GameOverReturnTitleGuard(readable, guard)
+                    : practiceFailureRoute
+                    ? thprac_scene_bridge::Th10PracticeGameOverReturnTitleGuard(readable, guard)
+                    : thprac_scene_bridge::Th10PracticeStageCompleteReturnTitleGuard(readable, guard);
+                if (!terminal) {
+                    SceneRestartPublish(requestSequence,
+                        thprac_scene_bridge::RestartStatus::Rejected,
+                        thprac_scene_bridge::RestartPhase::None, 5);
+                    return;
+                }
+                sceneRestartAwaitingTitle = true;
+                sceneRestartPhase = (LONG)thprac_scene_bridge::RestartPhase::AwaitTitle;
+                if (!SceneQueueRetailReturnToTitle()) {
+                    sceneRestartAwaitingTitle = false;
+                    sceneRestartPhase = (LONG)thprac_scene_bridge::RestartPhase::None;
+                    SceneRestartPublish(requestSequence,
+                        thprac_scene_bridge::RestartStatus::Failed,
+                        thprac_scene_bridge::RestartPhase::None, 6);
+                    return;
+                }
+                ++sceneRestartInputPolls;
+                SceneRestartPublish(requestSequence,
+                    thprac_scene_bridge::RestartStatus::ActionQueued,
+                    thprac_scene_bridge::RestartPhase::AwaitTitle);
+                return;
+            }
+        } else {
+            const LONG currentStatus = InterlockedCompareExchange(
+                &sceneBridge->restart_status, 0, 0);
+            if (sceneBridge->restart_response_sequence == requestSequence &&
+                (currentStatus == (LONG)thprac_scene_bridge::RestartStatus::Queued ||
+                 currentStatus == (LONG)thprac_scene_bridge::RestartStatus::ActionQueued))
+                recordInputState();
+        }
+
+        const auto phase = (thprac_scene_bridge::RestartPhase)sceneRestartPhase;
+        if (phase == thprac_scene_bridge::RestartPhase::None ||
+            phase == thprac_scene_bridge::RestartPhase::Complete ||
+            phase == thprac_scene_bridge::RestartPhase::TitleReady ||
+            sceneBridge->restart_response_sequence != requestSequence)
+            return;
+        if (GetTickCount64() >= sceneBridge->restart_deadline_tick_ms) {
+            sceneRestartAwaitingTitle = false;
+            sceneRestartPhase = (LONG)thprac_scene_bridge::RestartPhase::None;
+            sceneRetryPending = false;
+            SceneRestartPublish(requestSequence,
+                thprac_scene_bridge::RestartStatus::Failed,
+                thprac_scene_bridge::RestartPhase::None, 2);
+            return;
+        }
+        if (phase == thprac_scene_bridge::RestartPhase::AwaitTitle) {
+            SceneRestartPublish(requestSequence,
+                thprac_scene_bridge::RestartStatus::ActionQueued,
+                thprac_scene_bridge::RestartPhase::AwaitTitle);
+            return;
+        }
+    }
+
+    static bool SceneOpenMapping()
+    {
+        wchar_t name[96] {};
+        swprintf_s(name, L"Local\\THPracSceneBridge_TH10_%lu", GetCurrentProcessId());
+        sceneBridgeMappingHandle = CreateFileMappingW(INVALID_HANDLE_VALUE, nullptr, PAGE_READWRITE, 0, sizeof(Mapping), name);
+        if (!sceneBridgeMappingHandle) return false;
+        sceneBridge = (Mapping*)MapViewOfFile(sceneBridgeMappingHandle, FILE_MAP_ALL_ACCESS, 0, 0, sizeof(Mapping));
+        if (!sceneBridge) { CloseHandle(sceneBridgeMappingHandle); sceneBridgeMappingHandle = nullptr; return false; }
+        if (sceneBridge->magic != thprac_scene_bridge::kMagic || sceneBridge->version != thprac_scene_bridge::kVersion || sceneBridge->struct_size != sizeof(Mapping)) {
+            sceneBridge->magic = thprac_scene_bridge::kMagic;
+            sceneBridge->version = thprac_scene_bridge::kVersion;
+            sceneBridge->struct_size = sizeof(Mapping);
+            ScenePublish(Status::Idle);
+        }
+        return true;
+    }
+
+    static bool SceneTakeRequest()
+    {
+        if (!sceneBridge) return false;
+        LONG seq0 = InterlockedCompareExchange(&sceneBridge->request_sequence, 0, 0);
+        if (seq0 <= 0 || seq0 == sceneRequestSequence) return false;
+        Mapping copy {};
+        memcpy(&copy, sceneBridge, sizeof(copy));
+        MemoryBarrier();
+        LONG seq1 = InterlockedCompareExchange(&sceneBridge->request_sequence, 0, 0);
+        if (seq0 != seq1 || copy.request_sequence != seq0) return false;
+        sceneRequest = copy;
+        sceneRequestSequence = seq0;
+        sceneRetryPending = false;
+        sceneRetrySequence = 0;
+        memset(sceneRetryRequestId, 0, sizeof(sceneRetryRequestId));
+        sceneRetryDeadlineMs = 0;
+        sceneFrontendActive = true;
+        sceneDialogueHarness.Disable();
