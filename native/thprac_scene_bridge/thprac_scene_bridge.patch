+    static void SceneDialogueBranch(PCONTEXT ctx, std::int32_t messageCase)
+    {
+        SceneDialogueLeaseTick();
+        ++sceneDialogueBranchVisits;
+        const bool zeroFlag = (ctx->EFlags & 0x40) != 0;
+        const bool forceAdvance = sceneDialogueHarness.ShouldAdvance(GetTickCount64(), messageCase, zeroFlag);
+        ctx->Eip = (DWORD)thprac_scene_bridge::Th10DialogueNextIp(messageCase, zeroFlag, forceAdvance);
+        if (forceAdvance && zeroFlag)
+            ++sceneDialogueAdvanceOverrides;
+        if (sceneBridge) {
+            SceneBeginResponseWrite();
+            sceneBridge->dialogue_advance_forced = sceneDialogueAdvanceOverrides;
+            sceneBridge->dialogue_branch_visits = sceneDialogueBranchVisits;
+            SceneEndResponseWrite();
+        }
+    }
+
+    static void SceneDialogueLeaseTick()
+    {
+        if (!sceneBridge || !sceneDialogueHooksReady) return;
+        const uint64_t now = GetTickCount64();
+        if (sceneDialogueHarness.active()
+            && (sceneDialogueLeaseRequestSequence != sceneRequestSequence
+                || memcmp(sceneDialogueLeaseRequestId, sceneRequest.request_id, sizeof(sceneDialogueLeaseRequestId)) != 0)) {
+            sceneDialogueHarness.Disable();
+            sceneDialogueLeaseDurationMs = 0;
+            sceneDialogueLeaseDeadlineMs = 0;
+        }
+        const LONG firstGeneration = InterlockedCompareExchange(&sceneBridge->dialogue_lease_generation, 0, 0);
+        if (!(firstGeneration & 1) && firstGeneration != sceneDialogueLeaseGeneration) {
+            const LONG duration = sceneBridge->dialogue_lease_ms;
+            const uint64_t deadline = sceneBridge->dialogue_lease_deadline_tick_ms;
+            const LONG requestSequence = sceneBridge->dialogue_lease_request_sequence;
+            uint8_t requestId[16] = {};
+            memcpy(requestId, sceneBridge->dialogue_lease_request_id, sizeof(requestId));
+            const LONG secondGeneration = InterlockedCompareExchange(&sceneBridge->dialogue_lease_generation, 0, 0);
+            if (firstGeneration == secondGeneration && !(secondGeneration & 1)) {
+                sceneDialogueLeaseGeneration = secondGeneration;
+                const bool sameSession = requestSequence == sceneRequestSequence
+                    && sceneBridge->request_sequence == sceneRequestSequence
+                    && memcmp(requestId, sceneRequest.request_id, sizeof(requestId)) == 0;
+                if (sameSession && duration == 0) {
+                    sceneDialogueHarness.Disable();
+                    sceneDialogueLeaseDurationMs = 0;
+                    sceneDialogueLeaseDeadlineMs = 0;
+                    sceneDialogueLeaseRequestSequence = requestSequence;
+                    memcpy(sceneDialogueLeaseRequestId, requestId, sizeof(requestId));
+                } else if (sameSession && duration > 0
+                    && duration <= (LONG)thprac_scene_bridge::DialogueHarness::kMaxDurationMs
+                    && deadline > now && deadline - now <= (uint64_t)duration
+                    && sceneDialogueHarness.RenewUntil(now, deadline)) {
+                    sceneDialogueLeaseDurationMs = duration;
+                    sceneDialogueLeaseDeadlineMs = deadline;
+                    sceneDialogueLeaseRequestSequence = requestSequence;
+                    memcpy(sceneDialogueLeaseRequestId, requestId, sizeof(requestId));
+                } else {
+                    sceneDialogueHarness.Disable();
+                    sceneDialogueLeaseDurationMs = 0;
+                    sceneDialogueLeaseDeadlineMs = 0;
+                }
+            }
+        }
+        sceneDialogueHarness.Poll(now);
+        SceneBeginResponseWrite();
+        sceneBridge->dialogue_advance_ms = sceneDialogueLeaseDurationMs;
+        sceneBridge->dialogue_advance_deadline_tick_ms = sceneDialogueLeaseDeadlineMs;
+        SceneEndResponseWrite();
+    }
